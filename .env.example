# --- Localização e Tenant ---
TENANT_ID=00000000-0000-0000-0000-000000000000
APP_TIMEZONE=America/Sao_Paulo

# --- Banco de Dados (PostgreSQL) ---
POSTGRES_DB=RadianciaDb
POSTGRES_USER=radianciaKS
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui
POSTGRES_PORT=5432

# --- Credenciais de DataSeed Inicial ---
ADMIN_INITIAL_CPF=11111111100
ADMIN_INITIAL_PASSWORD=admin@2026

# --- Back-end (.NET 8) ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
JWT_SECRET=defina_uma_chave_secreta_com_mais_de_32_caracteres
JWT_EXPIRATION_MINUTES=720

# --- Front-end (Angular + Nginx) ---
WEB_PORT=80

# --- Acesso Remoto (Cloudflare Tunnels) ---
CLOUDFLARE_TUNNEL_TOKEN=seu_token_do_tunnel_aqui

# --- Backup em Nuvem (Cloudflare R2) ---
CLOUDFLARE_R2_ENDPOINT=https://<SUA_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=<SEU_ACCESS_KEY_ID>
CLOUDFLARE_R2_SECRET_ACCESS_KEY=<SEU_SECRET_ACCESS_KEY>
CLOUDFLARE_R2_BUCKET_NAME=radianciaks-backups

# --- Licenciamento (Keygen.sh) ---
KEYGEN_ACCOUNT_ID=o_seu_account_id_aqui
KEYGEN_LICENSE_KEY=a_chave_gerada_no_keygen_aqui

# --- Atualizações Automáticas (Watchtower) ---
WATCHTOWER_RUN_ONCE=true
WATCHTOWER_CLEANUP=true
GHCR_TOKEN=token_gerado